{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "../dist",
    "rootDir": "..",
    "types": ["node"],
    "isolatedModules": false
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"],
  // Tests run through vitest against the TypeScript sources, so compiling them
  // into dist/ only ships test code inside the packaged app.
  "exclude": ["./**/*.test.ts", "../shared/**/*.test.ts"]
}
